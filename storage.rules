rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /profile_photos/users/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
    }
    match /profile_photos/players/{playerId}/{fileName} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && request.auth.token.admin == true;
    }
    match /profile_photos/coaches/{coachId}/{fileName} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && request.auth.token.admin == true;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
