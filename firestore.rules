rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isCoach() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Coach';
    }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }

    match /users/{userId} {
      allow create: if isOwner(userId) && request.resource.data.role in ['Player', 'Parent', 'Coach'];
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /players/{playerId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coachId', 'updatedAt'])
        && request.resource.data.coachId is string
        && exists(/databases/$(database)/documents/coaches/$(request.resource.data.coachId))
        && get(/databases/$(database)/documents/coaches/$(request.resource.data.coachId)).data.active == true
        && (
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Player' && resource.data.email == request.auth.token.email)
          || (isCoach() && request.resource.data.coachId == request.auth.uid && (resource.data.coachId == '' || resource.data.coachId == request.auth.uid))
        )
      );
    }

    match /teams/{teamId} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /coaches/{coachId} {
      allow read: if signedIn();
      allow create: if isOwner(coachId) && request.resource.data.email == request.auth.token.email && request.resource.data.active == true;
      allow update, delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if signedIn() && (
        isAdmin()
        || (resource.data.playerId is string && get(/databases/$(database)/documents/players/$(resource.data.playerId)).data.email == request.auth.token.email)
        || (isCoach() && resource.data.coachId == request.auth.uid)
      );
      allow create, update: if isAdmin() || (isCoach() && request.resource.data.coachId == request.auth.uid && get(/databases/$(database)/documents/players/$(request.resource.data.playerId)).data.coachId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /training_sessions/{sessionId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (isCoach() && request.resource.data.coachId == request.auth.uid);
      allow update, delete: if isAdmin() || (isCoach() && resource.data.coachId == request.auth.uid);
    }
    match /fixtures/{fixtureId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (isCoach() && request.resource.data.coachId == request.auth.uid);
      allow update, delete: if isAdmin() || (isCoach() && resource.data.coachId == request.auth.uid);
    }
    match /announcements/{announcementId} { allow read: if signedIn(); allow create, update, delete: if isAdmin(); }

    // Finance: admins manage billing; parents see only records explicitly linked to their account.
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (signedIn() && resource.data.parentId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.parentId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    match /fee_categories/{categoryId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /scholarships/{scholarshipId} {
      allow read: if isAdmin() || (signedIn() && resource.data.parentId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if isAdmin(); }
  }
}
